#!/usr/bin/env bash
set -euo pipefail

if ! fish_path="$(command -v fish)"; then
  echo "fish is not installed or is not on PATH. Run ./scripts/bootstrap first."
  exit 1
fi

if ! grep -Fxq "$fish_path" /etc/shells; then
  echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi

chsh -s "$fish_path"
